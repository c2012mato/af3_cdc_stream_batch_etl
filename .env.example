# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=etl_db
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_password
POSTGRES_SCHEMA=etl_demo

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CDC_TOPIC=etl_cdc_events
KAFKA_STREAM_TOPIC=etl_stream_events
KAFKA_CONSUMER_GROUP=etl_consumers

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Debezium Configuration
DEBEZIUM_CONNECT_URL=http://debezium:8083
DEBEZIUM_CONNECTOR_NAME=etl-postgres-connector

# Processing Configuration
BATCH_INTERVAL_SECONDS=60
STREAM_WINDOW_SECONDS=30
ANOMALY_THRESHOLD=2.0
DATA_GENERATOR_INTERVAL=5
MAX_RECORDS_PER_BATCH=1000

# Monitoring Configuration
METRICS_PORT=8000
LOG_LEVEL=INFO
ENABLE_PROMETHEUS=true

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@airflow-postgres/airflow
AIRFLOW__CELERY__BROKER_URL=redis://:@airflow-redis:6379/0
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true